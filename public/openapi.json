    "/v1/tools/search": {
      "post": {
        "operationId": "search",
        "summary": "Platform-friendly search surface",
        "description": "Simplified search returning normalized result items. Wraps find_passages and accepts the same official filter scope.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "type": "string",
                    "maxLength": 80,
                    "description": "Search query string. Maximum 80 characters."
                  },
                  "canon": {
                    "type": "string",
                    "description": "Comma-separated CBETA canon ids (e.g. \"T\" or \"T,X\"). Allowed: A, AC, B, C, CC, D, F, G, GA, GB, GJ, I, J, JM, JT, K, KZ, L, LC, M, N, P, PN, Q, QC, R, S, SS, SX, SZ, T, TW, TX, U, X, Y, YN, YP, Z, ZS, ZW."
                  },
                  "category": {
                    "type": "string",
                    "description": "Official category expression using a,b+c,d grammar where + is AND and , is OR. Values must come from the official category vocabulary (e.g. 阿含部類, 般若部類, 律部類)."
                  },
                  "creator": {
                    "type": "string",
                    "description": "Creator (author/translator) IDs, not display names. Each id matches [A-Z] followed by six digits (e.g. A000420). Supports a,b+c,d grammar."
                  },
                  "dynasty": {
                    "type": "string",
                    "description": "Dynasty filter."
                  },
                  "time": {
                    "type": "string",
                    "description": "Single year (e.g. \"800\") or an inclusive range using .. (e.g. \"800..900\")."
                  },
                  "work": {
                    "type": "string",
                    "description": "Single work id."
                  },
                  "works": {
                    "type": "string",
                    "description": "Comma-separated work ids."
                  },
                  "work_type": {
                    "type": "string",
                    "enum": [
                      "textbody",
                      "non-textbody"
                    ],
                    "description": "Restrict to scripture body or non-body works."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized tool response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "tool": {"type": "string"},
                    "request_id": {"type": "string"},
                    "data": {
                      "type": "object",
                      "properties": {
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {"type": "string"},
                              "title": {"type": "string"},
                              "url": {"type": "string"},
                              "metadata": {
                                "type": "object",
                                "properties": {
                                  "canon": {"type": "string"},
                                  "category": {"type": "string"},
                                  "work": {"type": "string"},
                                  "file": {"type": "string"},
                                  "juan": {"type": "integer"},
                                  "byline": {"type": "string"},
                                  "term_hits": {"type": "integer"},
                                  "kwic": {"type": "string"},
                                  "lb": {"type": "string"},
                                  "vol": {"type": "string"}
                                },
                                "additionalProperties": true
                              }
                            },
                            "additionalProperties": true,
                            "required": [
                              "id",
                              "title",
                              "url"
                            ]
                          }
                        }
                      },
                      "additionalProperties": true,
                      "required": ["results"]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "tool": {"type": "string"},
                    "request_id": {"type": "string"},
                    "error_code": {"type": "string"},
                    "message": {"type": "string"},
                    "retryable": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    },
