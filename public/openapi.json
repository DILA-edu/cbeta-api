                              "canon": {"type": "string"},
                              "category": {"type": "string"},
                              "vol": {"type": "string"},
                              "file": {"type": "string"},
                              "work": {"type": "string"},
                              "title": {"type": "string"},
                              "juan": {"type": "integer"},
                              "lb": {"type": "string"},
                              "n": {"type": "string"},
                              "content": {"type": "string"},
                              "highlight": {"type": "string"}
                            },
                            "additionalProperties": true
                          }
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "tool": {"type": "string"},
                    "request_id": {"type": "string"},
                    "error_code": {"type": "string"},
                    "message": {"type": "string"},
                    "retryable": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/tools/resolve_citation": {
      "post": {
        "operationId": "resolve_citation",
        "summary": "Resolve a citation to a CBETA location",
        "description": "Resolve a free-text linehead or structured citation fields to a canonical CBETA location.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "description": "Provide either linehead, or all of canon, work, page, col, line.",
                "properties": {
                  "linehead": {
                    "type": "string",
                    "description": "CBETA linehead anchor."
                  },
                  "canon": {
                    "type": "string",
                    "description": "Comma-separated CBETA canon ids (e.g. \"T\" or \"T,X\"). Allowed: A, AC, B, C, CC, D, F, G, GA, GB, GJ, I, J, JM, JT, K, KZ, L, LC, M, N, P, PN, Q, QC, R, S, SS, SX, SZ, T, TW, TX, U, X, Y, YN, YP, Z, ZS, ZW."
                  },
                  "work": {
                    "type": "string",
                    "description": "Work id (e.g. 0001)."
                  },
                  "juan": {
                    "type": "string",
                    "description": "Juan (卷) number."
                  },
                  "page": {
                    "type": "string",
                    "description": "Page number."
                  },
                  "col": {
                    "type": "string",
                    "enum": [
                      "a",
                      "b",
                      "c"
                    ],
                    "description": "Column: a, b, or c."
                  },
                  "line": {
                    "type": "string",
                    "description": "Line number."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized tool response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "tool": {"type": "string"},
                    "request_id": {"type": "string"},
                    "data": {
                      "type": "object",
                      "properties": {
                        "num_found": {"type": "integer"},
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "vol": {"type": "string"},
                              "lb": {"type": "string"},
                              "work": {"type": "string"},
                              "file": {"type": "string"},
                              "juan": {"type": "integer"},
                              "linehead": {"type": "string"},
                              "title": {"type": "string"}
                            },
                            "additionalProperties": true
                          }
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "tool": {"type": "string"},
                    "request_id": {"type": "string"},
                    "error_code": {"type": "string"},
                    "message": {"type": "string"},
                    "retryable": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/tools/get_context": {
      "post": {
        "operationId": "get_context",
        "summary": "Retrieve context lines around a linehead",
        "description": "Return surrounding text lines for a CBETA linehead anchor, or for a linehead_start/linehead_end range.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "description": "Provide either linehead, or both linehead_start and linehead_end.",
                "properties": {
                  "linehead": {
                    "type": "string",
                    "description": "Single CBETA linehead anchor (e.g. T01n0001_p0001a01)."
                  },
                  "linehead_start": {
                    "type": "string",
                    "description": "Range start linehead. Requires linehead_end."
                  },
                  "linehead_end": {
                    "type": "string",
                    "description": "Range end linehead. Requires linehead_start."
                  },
                  "before": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 5,
                    "description": "Lines of context before the anchor."
                  },
                  "after": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 5,
                    "description": "Lines of context after the anchor."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized tool response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "tool": {"type": "string"},
                    "request_id": {"type": "string"},
                    "data": {
                      "type": "object",
                      "properties": {
                        "num_found": {"type": "integer"},
                        "time": {"type": "number"},
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "linehead": {"type": "string"},
                              "html": {"type": "string"},
                              "notes": {
                                "type": "object",
                                "additionalProperties": {"type": "string"}
                              }
                            },
                            "additionalProperties": true
                          }
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "tool": {"type": "string"},
                    "request_id": {"type": "string"},
                    "error_code": {"type": "string"},
                    "message": {"type": "string"},
                    "retryable": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    },
