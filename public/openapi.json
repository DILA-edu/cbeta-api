    "/v1/tools/search_similar": {
      "post": {
        "operationId": "search_similar",
        "summary": "Semantic similar-passage search",
        "description": "Find passages semantically similar to a short query (recommended 6–50 characters). Supports the same filter scope as full-text search.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["q"],
                "additionalProperties": false,
                "properties": {
                  "q": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 50,
                    "description": "Query text, 6–50 characters."
                  },
                  "k": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 500,
                    "description": "Candidate pool size."
                  },
                  "gain": {
                    "type": "number",
                    "minimum": 0,
                    "default": 2,
                    "description": "Match gain weight."
                  },
                  "penalty": {
                    "type": "number",
                    "maximum": 0,
                    "default": -1,
                    "description": "Mismatch penalty weight (<= 0)."
                  },
                  "score_min": {
                    "type": "number",
                    "minimum": 0,
                    "default": 16,
                    "description": "Minimum score threshold."
                  },
                  "canon": {
                    "type": "string",
                    "description": "Comma-separated CBETA canon ids (e.g. \"T\" or \"T,X\"). Allowed: A, AC, B, C, CC, D, F, G, GA, GB, GJ, I, J, JM, JT, K, KZ, L, LC, M, N, P, PN, Q, QC, R, S, SS, SX, SZ, T, TW, TX, U, X, Y, YN, YP, Z, ZS, ZW."
                  },
                  "category": {
                    "type": "string",
                    "description": "Official category expression using a,b+c,d grammar where + is AND and , is OR. Values must come from the official category vocabulary (e.g. 阿含部類, 般若部類, 律部類)."
                  },
                  "creator": {
                    "type": "string",
                    "description": "Creator (author/translator) IDs, not display names. Each id matches [A-Z] followed by six digits (e.g. A000420). Supports a,b+c,d grammar."
                  },
                  "dynasty": {
                    "type": "string",
                    "description": "Dynasty filter."
                  },
                  "time": {
                    "type": "string",
                    "description": "Single year (e.g. \"800\") or an inclusive range using .. (e.g. \"800..900\")."
                  },
                  "work": {
                    "type": "string",
                    "description": "Single work id."
                  },
                  "works": {
                    "type": "string",
                    "description": "Comma-separated work ids."
                  },
                  "work_type": {
                    "type": "string",
                    "enum": [
                      "textbody",
                      "non-textbody"
                    ],
                    "description": "Restrict to scripture body or non-body works."
                  },
                  "facet": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Facet flag (0 or 1)."
                  },
                  "cache": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Cache flag (0 or 1)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized tool response",
            "content": {
              "application/json": {
                "schema": {
